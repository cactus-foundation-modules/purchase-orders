{
  "name": "purchase-orders",
  "version": "0.1.15",
  "tablePrefix": "po_",
  "description": "Raise purchase orders to your suppliers, check what turns up against what you ordered, and match their invoice before you pay it.",
  "publicBasePath": "purchase-order",
  "requiresCoreVersion": "0.5.1350",
  "permissions": [
    "purchase-orders.access",
    "purchase-orders.create",
    "purchase-orders.approve",
    "purchase-orders.receive",
    "purchase-orders.bills",
    "purchase-orders.catalogues",
    "purchase-orders.settings"
  ],
  "navGroupLabel": "Purchasing",
  "navEntries": [
    {
      "label": "Purchase Orders",
      "path": "/m/purchase-orders/orders",
      "icon": "<path d=\"M9 3h6v3H9z\"/><path d=\"M15 4.5h3V21H6V4.5h3\"/><path d=\"M9 11h6M9 15h4\"/>",
      "permission": "purchase-orders.access"
    }
  ],
  "requiredEnvVars": [],
  "cookieCategories": [],
  "requiresModules": [],
  "cronJobs": [
    {
      "path": "/api/m/purchase-orders/cron/reorder",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/m/purchase-orders/cron/chase",
      "schedule": "0 7 * * *"
    }
  ],
  "extensionPoints": [
    {
      "point": "core.media-usage-providers",
